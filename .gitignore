cat << 'EOF' > .gitignore
# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*

# Build outputs
.next/
*/.next/
out/
build/
dist/

# Environment files
.env
.env*.local
*.env

# Vercel
.vercel/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
EOF